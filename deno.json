{
  "tasks": {
    "start": "deno run --allow-read --allow-write --allow-net --allow-env=OCR_ACCURATE,OCR_ACCURATE_SECONDS --allow-run=xcrun,xcodebuild,swiftc,git,security,openssl,build/ocr src/start.ts",
    "test": "deno test --allow-read",
    "check": "deno check src/start.ts && deno lint",
    "runs": "deno run --allow-read --allow-write src/history.ts",
    "decisions": "deno run --allow-read src/why.ts",
    "fmt": "deno fmt"
  },
  "exclude": ["vendor/", "build/", ".direnv/"],
  "fmt": {
    "lineWidth": 120,
    "proseWrap": "preserve",
    "exclude": ["src/digits.json"]
  },
  "imports": {
    "@std/assert": "jsr:@std/assert@^1.0.19",
    "@std/cli": "jsr:@std/cli@^1.0.32",
    "@std/dotenv": "jsr:@std/dotenv@^0.225.5",
    "fast-png": "npm:fast-png@6.2.0",
    "@std/streams": "jsr:@std/streams@^1.0.0",
    "@std/encoding": "jsr:@std/encoding@^1.0.0"
  }
}
